<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no">
<meta name="theme-color" content="#070b14">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Thrade · 持仓量化面板</title>
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" href="assets/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="assets/icon.svg">
<link rel="stylesheet" href="assets/style.css">
</head>
<body>
<div class="bg-grid"></div>

<header class="topbar">
  <div class="brand">
    <span class="brand-dot"></span>
    <span class="brand-name">THRADE</span>
    <span class="brand-sub">持仓量化</span>
  </div>
  <div class="top-actions">
    <button class="icon-btn" id="btn-refresh" title="刷新行情" aria-label="刷新行情">
      <svg viewBox="0 0 24 24"><path d="M4 4v5h5M20 20v-5h-5M5.5 15a7 7 0 0 0 12 3M18.5 9a7 7 0 0 0-12-3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button class="icon-btn" id="btn-settings" title="设置" aria-label="设置">
      <svg viewBox="0 0 24 24"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
    </button>
  </div>
</header>

<main id="main">
  <!-- ============ 持仓 ============ -->
  <section class="view" id="view-holdings">
    <div class="hero card">
      <div class="hero-label">总持仓市值</div>
      <div class="hero-value" id="total-mv">--</div>
      <div class="hero-row">
        <div><span class="k">浮动盈亏</span><b id="total-pnl" class="v">--</b></div>
        <div><span class="k">仓位占比</span><b id="total-weight" class="v">--</b></div>
      </div>
      <canvas id="spark-total" class="spark" height="46"></canvas>
    </div>

    <div class="section-head">
      <h2>持仓明细</h2>
      <button class="ghost-btn" id="btn-add-holding">+ 添加持仓</button>
    </div>
    <div id="holding-list" class="list"></div>
    <div class="empty" id="holding-empty">
      <p>还没有持仓</p>
      <p class="dim">添加后可实时查看盈亏、仓位与风险指标</p>
    </div>
  </section>

  <!-- ============ 行情 ============ -->
  <section class="view" id="view-market">
    <div class="search-row">
      <input id="search-input" class="search" type="search" inputmode="text" placeholder="输入代码或名称，如 600519 / 贵州茅台" autocomplete="off">
      <button class="primary-btn" id="btn-search">查询</button>
    </div>
    <div id="search-hint" class="hint"></div>

    <div id="quote-panel" class="hidden">
      <div class="card quote-card">
        <div class="quote-head">
          <div>
            <div class="quote-name" id="q-name">--</div>
            <div class="quote-code" id="q-code">--</div>
          </div>
          <div class="quote-price">
            <div id="q-price">--</div>
            <div id="q-change">--</div>
          </div>
        </div>
        <div class="quote-stats">
          <div><span>今开</span><b id="q-open">--</b></div>
          <div><span>最高</span><b id="q-high">--</b></div>
          <div><span>最低</span><b id="q-low">--</b></div>
          <div><span>昨收</span><b id="q-prev">--</b></div>
          <div><span>成交量</span><b id="q-vol">--</b></div>
          <div><span>换手率</span><b id="q-turn">--</b></div>
        </div>
        <canvas id="spark-price" class="spark tall" height="90"></canvas>
      </div>

      <div class="grid-2">
        <div class="card mini"><span>MA5</span><b id="i-ma5">--</b></div>
        <div class="card mini"><span>MA20</span><b id="i-ma20">--</b></div>
        <div class="card mini"><span>RSI(14)</span><b id="i-rsi">--</b></div>
        <div class="card mini"><span>MACD</span><b id="i-macd">--</b></div>
        <div class="card mini"><span>ATR(14)</span><b id="i-atr">--</b></div>
        <div class="card mini"><span>量比</span><b id="i-vr">--</b></div>
      </div>

      <div class="card" id="signal-card">
        <div class="card-title">技术信号</div>
        <div class="signal-row"><span>均线</span><b id="s-ma">--</b></div>
        <div class="signal-row"><span>量能</span><b id="s-vol">--</b></div>
        <div class="signal-row"><span>RSI 区间</span><b id="s-rsi">--</b></div>
        <div class="signal-row"><span>MACD</span><b id="s-macd">--</b></div>
      </div>
    </div>
  </section>

  <!-- ============ 回测 ============ -->
  <section class="view" id="view-backtest">
    <div class="card">
      <div class="card-title">策略回测 <span class="dim" id="bt-target">未选择标的</span></div>
      <p class="dim small">规则：MA5 上穿 MA20 买入，下穿卖出；按收盘价成交，不计手续费。</p>
      <button class="primary-btn wide" id="btn-backtest" disabled>运行回测</button>
    </div>

    <div id="bt-result" class="hidden">
      <div class="grid-2">
        <div class="card stat"><span>胜率</span><b id="bt-win">--</b></div>
        <div class="card stat"><span>盈亏比</span><b id="bt-odds">--</b></div>
        <div class="card stat"><span>期望值</span><b id="bt-exp">--</b></div>
        <div class="card stat"><span>凯利仓位</span><b id="bt-kelly">--</b></div>
        <div class="card stat"><span>交易次数</span><b id="bt-count">--</b></div>
        <div class="card stat"><span>最大回撤</span><b id="bt-dd">--</b></div>
      </div>
      <div class="card">
        <div class="card-title">资金曲线</div>
        <canvas id="equity-chart" class="chart" height="160"></canvas>
      </div>
      <div class="card" id="plan-card">
        <div class="card-title">仓位与风控</div>
        <div class="plan-row"><span>建议仓位</span><b id="plan-size">--</b></div>
        <div class="plan-row"><span>建议股数</span><b id="plan-shares">--</b></div>
        <div class="plan-row"><span>止损价</span><b id="plan-sl" class="down">--</b></div>
        <div class="plan-row"><span>止盈价</span><b id="plan-tp" class="up">--</b></div>
        <div class="plan-row"><span>单笔风险</span><b id="plan-risk">--</b></div>
      </div>
    </div>
    <div class="empty" id="bt-empty">
      <p>先在「行情」里查询一个标的</p>
      <p class="dim">再回到这里运行回测</p>
    </div>
  </section>

  <!-- ============ 报告 ============ -->
  <section class="view" id="view-report">
    <div class="card">
      <div class="card-title">持仓截图</div>
      <p class="dim small">截图仅用于本机对照录入，不会上传。</p>
      <label class="upload" id="upload-label">
        <input type="file" id="shot-input" accept="image/*" hidden>
        <span id="upload-text">选择持仓截图</span>
        <img id="shot-preview" class="hidden" alt="持仓截图">
      </label>
    </div>

    <div class="card">
      <div class="card-title">分析报告（JSON）</div>
      <pre id="report-json" class="code">--</pre>
      <button class="ghost-btn wide" id="btn-copy-report">复制 JSON</button>
    </div>

    <div class="card">
      <div class="card-title">数据诊断</div>
      <p class="dim small">如果行情加载失败，把这里的内容截图发我。</p>
      <pre id="diag" class="code small">--</pre>
      <button class="ghost-btn wide" id="btn-diag">重新检测</button>
    </div>
  </section>
</main>

<nav class="tabbar">
  <button class="tab active" data-view="holdings">
    <svg viewBox="0 0 24 24"><path d="M3 7h18v12H3zM3 7l3-3h12l3 3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
    <span>持仓</span>
  </button>
  <button class="tab" data-view="market">
    <svg viewBox="0 0 24 24"><path d="M4 18V9m5 9V5m5 13v-6m5 6V8" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg>
    <span>行情</span>
  </button>
  <button class="tab" data-view="backtest">
    <svg viewBox="0 0 24 24"><path d="M4 19h16M6 15l4-5 3 3 5-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span>回测</span>
  </button>
  <button class="tab" data-view="report">
    <svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6zM15 3v4h4M9 12h7M9 16h7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
    <span>报告</span>
  </button>
</nav>

<div id="sheet-root"></div>
<div id="toast" class="toast"></div>

<script src="assets/api.js"></script>
<script src="assets/calc.js"></script>
<script src="assets/app.js"></script>
<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', function () {
      navigator.serviceWorker.register('sw.js').catch(function () {});
    });
  }
</script>
</body>
</html>
